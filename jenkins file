pipeline {
    agent any

    environment {
        TOMCAT_PATH = "C:\\Program Files\\Apache Software Foundation\\Tomcat 10.1\\webapps\\hospital"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/abrarulhaqhaq04-stack/hospital-management-system.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Static website - No build required'
            }
        }

        stage('Deploy') {
            steps {
                bat """
                if exist "%TOMCAT_PATH%" rmdir /S /Q "%TOMCAT_PATH%"
                mkdir "%TOMCAT_PATH%"
                xcopy *.html "%TOMCAT_PATH%\\" /Y
                xcopy css "%TOMCAT_PATH%\\css\\" /E /I /Y
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment Successful!'
            emailext(
                to: 'jenkinsmailer-email.gwuonqv4@zohomail-1-3.pagerduty.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Deployment Successful.\nJob: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}"
            )
        }

        failure {
            echo 'Deployment Failed!'
            emailext(
                to: 'jenkinsmailer-email.gwuonqv4@zohomail-1-3.pagerduty.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: "Deployment Failed.\nJob: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}"
            )
        }
    }
}
