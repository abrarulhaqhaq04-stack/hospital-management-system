pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/abrarulhaqhaq04-stack/hospital-management-system.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                bat 'if exist "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\hospital" rmdir /S /Q "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\hospital"'
                bat 'mkdir "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\hospital"'
                bat 'C:\\Windows\\System32\\xcopy.exe * "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\hospital\\" /E /Y /I'
            }
        }

    }

    post {
        always {
            echo 'Pipeline completed.'
