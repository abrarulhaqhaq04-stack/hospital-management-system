
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url:'https://github.com/abrarulhaqhaq04-stack/Hospital-Management-System.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                stage('Deploy') {
    steps {
        bat '''
        if exist "C:\\apache-tomcat-9.0\\webapps\\HospitalManagement" (
            rmdir /S /Q "C:\\apache-tomcat-9.0\\webapps\\HospitalManagement"
        )

        mkdir "C:\\apache-tomcat-9.0\\webapps\\HospitalManagement"

        C:\\Windows\\System32\\xcopy.exe * "C:\\apache-tomcat-9.0\\webapps\\HospitalManagement\\" /E /Y /I
        '''
    }
}
            
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
        }

        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }
    }
}
