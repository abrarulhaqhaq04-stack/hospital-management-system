
pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url:'https://github.com/abrarulhaqhaq04-stack/Hospital-Management-System.git'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project...'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }

        stage('Deploy') {
            steps {
                stage('Deploy') {
    steps {
           bat '''
                if not exist "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\Hospital" (
                    mkdir "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\Hospital"
                )

                robocopy . "C:\\tomcat\\apache-tomcat-9.0.68\\webapps\\Hospital" /E

                if %ERRORLEVEL% LEQ 7 (
                    exit /b 0
                ) else (
                    exit /b %ERRORLEVEL%
                )
                '''
    }
}  
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed.'
        }

        success {
            echo 'Build Successful!'
        }

        failure {
            echo 'Build Failed!'
        }
    }
}
